# Where the API server (python -m api) is, as the phone sees it. Copy to .env.local.
# iOS simulator and the web build: http://localhost:8000
# Android emulator: run `adb reverse tcp:8000 tcp:8000` and keep http://localhost:8000
# A real phone: the server's public HTTPS address (see the README, "Trying it on a phone").
EXPO_PUBLIC_API_URL=http://localhost:8000
